{
  "serverInfo": {
    "name": "xno-skills",
    "version": "5.2.0"
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "tools": [
    {
      "name": "system_diag",
      "title": "System Diagnostics",
      "description": "Show version and environment metadata for xno-skills and OWS. Useful for troubleshooting.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "config_get",
      "title": "Get Configuration",
      "description": "Read the current xno-mcp configuration including RPC URLs, timeouts, and spending limits.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "config_set",
      "title": "Set Configuration",
      "description": "Update the xno-mcp configuration. Any provided fields overwrite existing values; omitted fields are preserved. Set a string field to \"\" or null to reset it to default; set a number field to null to reset it to default.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rpcUrl": {
            "description": "Primary Nano RPC endpoint URL (set to \"\" or null to reset)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "workUrl": {
            "description": "Remote PoW endpoint URL (set to \"\" or null to reset)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeoutMs": {
            "description": "Request timeout in milliseconds (default: 15000)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "powTimeoutMs": {
            "description": "Proof-of-work timeout in milliseconds (default: max(timeoutMs * 4, 30000))",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "defaultRepresentative": {
            "description": "Default representative nano_ address for new accounts (set to \"\" or null to reset)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxSendXno": {
            "description": "Maximum XNO allowed per send transaction (default: 1.0, set to \"\" or null to reset)",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_create",
      "title": "Create Nano Wallet",
      "description": "Create a wallet in the local OWS vault. Call only when the user explicitly asks to create a wallet.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "description": "New wallet name"
          }
        },
        "required": [
          "name"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_list",
      "title": "List Wallets",
      "description": "List all OWS wallets that have Nano accounts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_address",
      "title": "Get Wallet Address",
      "description": "Show the Nano address for a specific OWS wallet and account index.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          }
        },
        "required": [
          "wallet"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_balance",
      "title": "Get Wallet Balance",
      "description": "Show balances and pending blocks for OWS wallets. Prefer wallets for multiple names in one batch.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "wallets": {
            "description": "Wallet names to query together",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "description": "OWS wallet name"
            }
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "count": {
            "default": 10,
            "description": "Max pending blocks to return",
            "type": "number"
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "address": {
                "type": "string"
              },
              "balanceRaw": {
                "type": "string"
              },
              "pendingRaw": {
                "type": "string"
              },
              "balanceXno": {
                "type": "string"
              },
              "pendingXno": {
                "type": "string"
              },
              "pendingBlocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "hash": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "hash",
                    "amount"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "address",
              "balanceRaw",
              "pendingRaw",
              "balanceXno",
              "pendingXno",
              "pendingBlocks"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "wallets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string"
                    },
                    "balanceRaw": {
                      "type": "string"
                    },
                    "pendingRaw": {
                      "type": "string"
                    },
                    "balanceXno": {
                      "type": "string"
                    },
                    "pendingXno": {
                      "type": "string"
                    },
                    "pendingBlocks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hash": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "hash",
                          "amount"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "wallet": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "address",
                    "balanceRaw",
                    "pendingRaw",
                    "balanceXno",
                    "pendingXno",
                    "pendingBlocks",
                    "wallet"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "wallets"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "wallet_receive",
      "title": "Receive Pending Blocks",
      "description": "Receive pending Nano blocks for an OWS wallet. Automatically handles open vs receive block creation, signs via OWS, generates PoW, and broadcasts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "count": {
            "default": 10,
            "description": "Max receivable blocks to consider",
            "type": "number"
          },
          "onlyHash": {
            "description": "Receive only this specific send block hash",
            "type": "string"
          },
          "representative": {
            "description": "Representative for first-open account (defaults to configured default)",
            "type": "string"
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        },
        "required": [
          "wallet"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_send",
      "title": "Send Nano",
      "description": "Send Nano from an OWS wallet. Signs via OWS, generates PoW, and broadcasts. Gated by a configurable per-transaction limit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "destination": {
            "type": "string",
            "description": "Destination Nano address (nano_...)"
          },
          "amountXno": {
            "type": "string",
            "description": "Amount to send in XNO (e.g. \"0.01\")"
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        },
        "required": [
          "wallet",
          "destination",
          "amountXno"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_change_rep",
      "title": "Change Representative",
      "description": "Change the representative for an OWS wallet account. Signs via OWS, generates PoW, and broadcasts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "representative": {
            "type": "string",
            "description": "New representative Nano address (nano_...)"
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        },
        "required": [
          "wallet",
          "representative"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_submit_block",
      "title": "Submit Prepared Block",
      "description": "Sign and submit a previously prepared unsigned Nano block hex using an OWS wallet. Useful for custom block workflows.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "txHex": {
            "type": "string",
            "description": "Unsigned block hex string"
          },
          "subtype": {
            "type": "string",
            "enum": [
              "send",
              "receive",
              "open",
              "change"
            ],
            "description": "Block subtype"
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        },
        "required": [
          "wallet",
          "txHex",
          "subtype"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wallet_info",
      "title": "Get Account Info",
      "description": "Discover the current state (balance, frontier, representative) of any Nano account by wallet name or explicit address.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "description": "OWS wallet name (alternative to address)",
            "type": "string"
          },
          "address": {
            "description": "Nano address to inspect (alternative to wallet)",
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "wallet_ows_health",
      "title": "OWS Health Check",
      "description": "Check whether the OWS wallet daemon is reachable and responding correctly.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "wallet_history",
      "title": "Get Transaction History",
      "description": "View the confirmed transaction history for an OWS wallet account.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "wallet": {
            "type": "string",
            "description": "OWS wallet name"
          },
          "index": {
            "description": "Account index (defaults to 0)",
            "type": "number"
          },
          "limit": {
            "default": 20,
            "description": "Max entries to return",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of entries to skip for pagination",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "wallet"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "payment_create",
      "title": "Create Payment Request",
      "description": "Create a tracked Nano payment request. Generates a QR code and returns a request ID for tracking.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "walletName": {
            "type": "string",
            "description": "OWS wallet name to receive funds"
          },
          "accountIndex": {
            "default": 0,
            "description": "Account index (OWS only supports 0)",
            "type": "number"
          },
          "amountXno": {
            "type": "string",
            "description": "Requested amount in XNO (e.g. \"0.1\")"
          },
          "reason": {
            "type": "string",
            "description": "Description or reason for the payment request"
          }
        },
        "required": [
          "walletName",
          "amountXno",
          "reason"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "payment_list",
      "title": "List Payment Requests",
      "description": "List tracked Nano payment requests, optionally filtered by wallet or status.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "walletName": {
            "description": "Filter by wallet name",
            "type": "string"
          },
          "status": {
            "description": "Filter by status: pending, partial, funded, received",
            "type": "string"
          },
          "limit": {
            "default": 50,
            "description": "Maximum results to return",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Number of results to skip for pagination",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "payment_status",
      "title": "Get Payment Status",
      "description": "Check the status of a specific payment request by ID.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment request ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "payment_receive",
      "title": "Receive Payment",
      "description": "Receive pending funds associated with a payment request. Updates the request status.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment request ID"
          },
          "sendHash": {
            "description": "Optional Nano send block hash to bind this receive when multiple receivables are pending",
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "payment_refund",
      "title": "Refund Payment",
      "description": "Refund a payment request by sending received funds back to their recorded original source. Requires confirmation with execute: true.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment request ID"
          },
          "execute": {
            "default": false,
            "description": "Set to true to execute the refund (dry-run otherwise)",
            "type": "boolean"
          },
          "confirmAddress": {
            "description": "Destination address for the refund (must match a recorded original source)",
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "util_convert",
      "title": "Convert Units",
      "description": "Convert between Nano units (raw, XNO).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Value to convert (e.g. \"1.5\")"
          },
          "from": {
            "type": "string",
            "description": "Source unit: raw or xno"
          },
          "to": {
            "type": "string",
            "description": "Target unit: raw or xno"
          }
        },
        "required": [
          "amount",
          "from",
          "to"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "util_validate",
      "title": "Validate Address",
      "description": "Validate a Nano address offline. Checks prefix, alphabet, and Blake2b-40 checksum.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "type": "string",
            "description": "Nano address to validate (nano_... or xrb_...)"
          }
        },
        "required": [
          "address"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "util_qr",
      "title": "Generate QR Code",
      "description": "Generate an ASCII or SVG QR code for a Nano address, optionally with an amount.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "type": "string",
            "description": "Nano address to encode (nano_...)"
          },
          "amountXno": {
            "description": "Optional amount in XNO to embed in the QR URI",
            "type": "string"
          },
          "format": {
            "default": "ascii",
            "description": "Output format: ascii or svg",
            "type": "string",
            "enum": [
              "ascii",
              "svg"
            ]
          }
        },
        "required": [
          "address"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "rpc_probe_caps",
      "title": "Probe RPC Capabilities",
      "description": "Probe Nano node RPC capabilities: JSON RPC, version, ledger-read, process, and remote PoW (work_generate) support.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rpcUrl": {
            "description": "RPC URL(s) to probe, comma-separated (defaults to configured URL)",
            "type": "string"
          },
          "timeoutMs": {
            "description": "Timeout per probe in milliseconds",
            "type": "number"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "rpc_account_balance",
      "title": "Get Account Balance (RPC)",
      "description": "Fetch confirmed balances and pending amounts via RPC. Prefer addresses for multiple Nano accounts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "address": {
            "description": "Nano address to query",
            "type": "string"
          },
          "addresses": {
            "description": "Nano addresses to query together",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rpcUrl": {
            "description": "Override RPC URL",
            "type": "string"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "outputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
