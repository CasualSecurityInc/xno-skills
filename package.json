{
  "name": "xno-skills",
  "version": "5.0.0",
  "description": "The Nano (XNO) toolkit for AI agents and developers. Send, receive, check balances, and manage payment requests without ever handling private keys.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "xno-skills": "bin/xno-skills",
    "xno-mcp": "bin/xno-mcp"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/.xno-mcp",
    "!dist/**/.xno-mcp/**",
    "assets",
    "skills"
  ],
  "scripts": {
    "preversion": "node scripts/assert-clean-worktree.js --all && npm test && node scripts/assert-clean-worktree.js --all",
    "version": "npm run build:esm && node scripts/assert-clean-worktree.js --untracked-only && git add --update",
    "check:generated": "node scripts/assert-clean-worktree.js --all",
    "postversion": "node -e \"const v=require('./package.json').version; console.log('Created tag v'+v+'. Next: git push --follow-tags (GitHub Actions will publish to npm + create the GitHub Release).');\"",
    "prebuild": "node scripts/update-version.js",
    "prebuild:esm": "node scripts/update-version.js",
    "prebuild:cjs": "node scripts/update-version.js",
    "test": "npm run build:esm && vitest run",
    "test:watch": "npm run build:esm && vitest",
    "dev": "tsx src/cli.ts",
    "eval:codex-wallet-journey": "node scripts/eval-codex-wallet-journey.mjs",
    "eval:opencode-wallet-journey": "node scripts/eval-codex-wallet-journey.mjs --runner opencode",
    "build": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "postbuild": "node scripts/generate-server-card.js && node scripts/generate-cli-refs.js",
    "postbuild:esm": "node scripts/generate-server-card.js && node scripts/generate-cli-refs.js",
    "prepack": "rm -rf dist && npm run build && npm run build:cjs",
    "pack:mcpb": "bash scripts/pack-mcpb.sh",
    "prepare": "husky"
  },
  "keywords": [
    "nano",
    "xno",
    "cryptocurrency",
    "nanocurrency",
    "wallet",
    "bip39",
    "bip44",
    "ed25519",
    "blake2b",
    "blockchain"
  ],
  "author": "Casual Security Inc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CasualSecurityInc/xno-skills.git"
  },
  "bugs": {
    "url": "https://github.com/CasualSecurityInc/xno-skills/issues"
  },
  "homepage": "https://github.com/CasualSecurityInc/xno-skills#readme",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/qrcode-svg": "^1.1.5",
    "@types/qrcode-terminal": "^0.12.2",
    "fallow": "3.31.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^1.7.0",
    "@open-wallet-standard/core": "^1.3.2",
    "@openrai/nano-core": "^3.5.0",
    "commander": "^14.0.3",
    "nano-rspow-node": "^0.17.1",
    "qrcode-svg": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
